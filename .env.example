# ==============================================================================
# KaushalDrishti (कौशल दृष्टि) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# All parameters have safe defaults and are fully optional for local execution.
# ==============================================================================

# Central Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000

# Database Configuration (defaults to local SQLite database)
DATABASE_URL=sqlite:///skillsight.db

# Frontend Monitoring Dashboard Configuration
DASHBOARD_PORT=3000

# Edge Agent Default Settings
CENTRE_ID=TC001
CENTRE_CONFIG=configs/centre_TC001.yaml
# Camera Source: 0 for laptop webcam, or RTSP/HTTP URL e.g. rtsp://admin:pass@192.168.1.100:554/live
CAMERA_SOURCE=0
BANDWIDTH_MODE=full
